<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TizNet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/user_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TizNet.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/user_comment">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TizNet.TextInput"
            android:id="@+id/aliasLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/admins_alias">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputAlias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textDirection="ltr" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.TizNet.TextInput"
            android:id="@+id/passwordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:endIconMode="password_toggle"
            android:hint="@string/admins_password">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textDirection="ltr" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.TizNet.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/admins_max_users">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputMaxUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.TizNet.TextInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="@string/admins_max_active">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputMaxActive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/admins_capabilities"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capSubAdmins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_add_sub" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capOutbound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_outbound" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capSublinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_sublinks" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capUserExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_user_extra" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capDomains"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_domains" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/capOutbounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admins_cap_outbounds" />
    </LinearLayout>
</ScrollView>
