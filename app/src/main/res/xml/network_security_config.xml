<?xml version="1.0" encoding="utf-8"?>
<!-- Hiddify panels are frequently reached over plain HTTP on local networks,
     so cleartext is permitted. Panel credentials are stored encrypted on device. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
